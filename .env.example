# Copy to .env for a local Docker run. The app reads these from the environment;
# GETs work with the defaults, but owner login needs the auth vars below.
# In production these are GitHub Actions secrets, NOT a .env on the VM — see
# docs/deploy.md. Never commit a real .env (it is git-ignored).

# Path to the SQLite database file.
# Default (local): ./olive.db in the backend working directory.
# In Docker the image sets this to /data/olive.db (a mounted volume).
OLIVE_DB=/data/olive.db

# Signing key for the session cookie (NOT a login credential — identity is proven
# via Google sign-in). Generate a strong value (run in Docker, no host tools):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this value logs the owner out of all sessions.
OLIVE_SESSION_SECRET=change-me-before-deploying

# Google OAuth 2.0 Web-application Client ID (public, not a secret). Create it in
# Google Cloud Console (see docs/deploy.md). For a local run, also add
# http://localhost:8000 as an authorized JavaScript origin. Must match the
# frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# The single Gmail address allowed to sign in as owner. Anyone else is rejected.
OLIVE_OWNER_EMAIL=

# Same Google client ID, exposed to the frontend build. docker-compose passes this
# as a build arg so Vite can bake it into the bundle (VITE_* vars are public).
# Keep in sync with GOOGLE_CLIENT_ID above.
VITE_GOOGLE_CLIENT_ID=

# Destination of the top-bar back arrow: the owner's landing page outside this app
# (e.g. https://example.com when the tracker is hosted on a subdomain). Baked into
# the bundle at build time. Leave blank to fall back to the app's own root.
VITE_HOME_URL=

# Cookie security. Prod is HTTPS (Caddy) so keep this true there. Set to false for
# a local HTTP run on http://localhost — browsers won't store a "secure" cookie
# over plain HTTP, so login would silently fail to stick.
OLIVE_COOKIE_SECURE=true
