# Copy to .env for local overrides. The app reads these from the environment;
# all have sensible defaults, so .env is optional.

# Path to the SQLite database file.
# Default (local): ./olive.db in the backend working directory.
# In Docker the image sets this to /data/olive.db (a mounted volume).
OLIVE_DB=/data/olive.db

# Signing key for the session cookie (NOT a login credential — identity is proven
# via Google sign-in). Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Store the real value in a .env file on the server (never commit it).
# Rotating this value logs the owner out of all sessions.
OLIVE_SESSION_SECRET=change-me-before-deploying

# Google OAuth 2.0 Web-application Client ID (public, not a secret). Create it in
# Google Cloud Console (see docs/auth.md §3). Must match the frontend's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# The single Gmail address allowed to sign in as owner. Anyone else is rejected.
OLIVE_OWNER_EMAIL=

# Same Google client ID, exposed to the frontend build. docker-compose passes this
# as a build arg so Vite can bake it into the bundle (VITE_* vars are public).
# Keep in sync with GOOGLE_CLIENT_ID above.
VITE_GOOGLE_CLIENT_ID=

# Set to false in local HTTP development environments (Caddy handles HTTPS in prod).
OLIVE_COOKIE_SECURE=true
